<UserControl x:Class="ModbusFluentTest.ServerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d:DesignHeight="420" d:DesignWidth="600"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">
    <GroupBox Header="Modbus TCP Server" Margin="4">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="PortTextBox" Width="60" Text="5020" Margin="0,0,10,0" />
                <TextBlock Text="Unit ID:" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox x:Name="UnitIdTextBox" Width="40" Text="1" Margin="0,0,10,0" />
                <Button x:Name="StartButton" Content="Start Server" Width="100" Click="StartButton_Click" Margin="0,0,6,0" />
                <Button x:Name="StopButton" Content="Stop Server" Width="100" Click="StopButton_Click" />
            </StackPanel>

            <GroupBox Header="Sample Read Register (40001) — server-side value" Grid.Row="1" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="6">
                    <TextBlock Text="Value:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="ReadRegisterValueTextBox" Width="80" Text="0" Margin="0,0,10,0" />
                    <Button x:Name="SetReadRegisterButton" Content="Apply to Server" Width="120" Click="SetReadRegisterButton_Click" />
                    <TextBlock Text="(clients read this)" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic" Foreground="Gray" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Sample Write Register (41001) — last value written by a client" Grid.Row="2" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" Margin="6">
                    <TextBlock Text="Value:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="WriteRegisterValueTextBox" Width="80" Text="0" IsReadOnly="True" Margin="0,0,10,0" />
                    <Button x:Name="RefreshWriteRegisterButton" Content="Refresh" Width="80" Click="RefreshWriteRegisterButton_Click" />
                    <TextBlock Text="(clients write this)" VerticalAlignment="Center" Margin="10,0,0,0" FontStyle="Italic" Foreground="Gray" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Log" Grid.Row="3">
                <TextBox x:Name="LogTextBox"
                         Margin="6"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         FontFamily="Consolas"
                         MinHeight="120" />
            </GroupBox>
        </Grid>
    </GroupBox>
</UserControl>
