<UserControl
    x:Class="ModbusFluentTest.ClientControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="420"
    d:DesignWidth="600"
    mc:Ignorable="d">
    <GroupBox Margin="4" Header="Modbus TCP Client">
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="0,0,0,8"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Text="Host:" />
                <TextBox
                    x:Name="HostTextBox"
                    Width="100"
                    Margin="0,0,10,0"
                    Text="127.0.0.1" />
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Text="Port:" />
                <TextBox
                    x:Name="PortTextBox"
                    Width="60"
                    Margin="0,0,10,0"
                    Text="5020" />
                <TextBlock
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Text="Unit ID:" />
                <TextBox
                    x:Name="UnitIdTextBox"
                    Width="40"
                    Margin="0,0,10,0"
                    Text="1" />
                <Button
                    x:Name="ConnectButton"
                    Width="90"
                    Margin="0,0,6,0"
                    Click="ConnectButton_Click"
                    Content="Connect" />
                <Button
                    x:Name="DisconnectButton"
                    Width="90"
                    Click="DisconnectButton_Click"
                    Content="Disconnect" />
            </StackPanel>

            <GroupBox
                Grid.Row="1"
                Margin="0,0,0,8"
                Header="Sample Read Register (40001)">
                <StackPanel Margin="6" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="Value:" />
                    <TextBox
                        x:Name="ReadValueTextBox"
                        Width="80"
                        Margin="0,0,10,0"
                        IsReadOnly="True"
                        Text="" />
                    <Button
                        x:Name="ReadButton"
                        Width="80"
                        Click="ReadButton_Click"
                        Content="Read" />
                </StackPanel>
            </GroupBox>

            <GroupBox
                Grid.Row="2"
                Margin="0,0,0,8"
                Header="Sample Write Register (41001)">
                <StackPanel Margin="6" Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Text="Value:" />
                    <TextBox
                        x:Name="WriteValueTextBox"
                        Width="80"
                        Margin="0,0,10,0"
                        Text="0" />
                    <Button
                        x:Name="WriteButton"
                        Width="80"
                        Click="WriteButton_Click"
                        Content="Write" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Log">
                <TextBox
                    x:Name="LogTextBox"
                    MinHeight="120"
                    Margin="6"
                    FontFamily="Consolas"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </GroupBox>
        </Grid>
    </GroupBox>
</UserControl>
